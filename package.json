{
  "name": "zyn-ai",
  "version": "1.8.0",
  "description": "Terminal coding agent with tools, persistent sessions, MCP integrations and portable Agent Skills",
  "author": "Zyn",
  "keywords": [
    "ai-agent",
    "cli-ai",
    "terminal-ai",
    "automation-agent",
    "developer-tools",
    "ai-cli",
    "nodejs-cli",
    "productivity-tool",
    "local-ai-agent",
    "command-line-ai",
    "tui-agent",
    "embeddable-agent",
    "ai-terminal",
    "llm-agent",
    "openai",
    "claude",
    "gemini",
    "zyn"
  ],
  "bin": {
    "zyn": "./zyn.js",
    "zyn-ai": "./zyn.js"
  },
  "type": "commonjs",
  "main": "./src/agent.js",
  "scripts": {
    "start": "node zyn.js",
    "dev": "node zyn.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.mjs",
    "test:tui": "python3 -m unittest discover -s tests -p '*pty.py' -v",
    "test:all": "npm run check && npm run check:commands && npm test && npm run test:tui",
    "bench:tui": "python3 scripts/benchmark-tui.py",
    "docs:commands": "node scripts/generate-command-reference.js",
    "check:commands": "node scripts/generate-command-reference.js --check"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "ink": "^7.1.0",
    "jose": "^6.2.18",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "session-file-store": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toZyn/Zyn-Agent.git"
  },
  "homepage": "https://github.com/toZyn/Zyn-Agent#readme",
  "bugs": {
    "url": "https://github.com/toZyn/Zyn-Agent/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "zyn.js",
    "src/",
    "data/",
    "assets/",
    "docs/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/agent.js",
    "./agent": "./src/agent.js"
  },
  "preferGlobal": true
}
